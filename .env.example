# DockerHub namespace used by docker-compose.yml
DOCKERHUB_NAMESPACE=ijgutierrez

# SMTP settings used by the backend container.
# Copy this file to .env and fill in real credentials when mail sending is required.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-user
MAIL_PASSWORD=your-smtp-password-or-token
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_HEALTH_ENABLED=false
MAIL_FROM=no-reply@example.com
MAIL_BASE_URL=http://localhost:8081
